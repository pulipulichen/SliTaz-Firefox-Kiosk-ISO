#!/bin/sh
set -eu
. /etc/kiosk.conf
export GTK_IM_MODULE=xim QT_IM_MODULE=xim XMODIFIERS=@im=SCIM
export NO_AT_BRIDGE=1
mkdir -p "$HOME/.scim" "$HOME/.mozilla/firefox/kiosk"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-launch --exit-with-session /usr/local/bin/kiosk-session
fi
xset s off 2>/dev/null || true
xset -dpms 2>/dev/null || true
openbox &
# XIM works even if the SliTaz package lacks a matching GTK3 SCIM plugin.
scim -c simple -e table -f x11 --no-socket -d >"$HOME/scim-setup.log" 2>&1
sleep 1
count=0
while [ "$count" -lt "$DHCP_WAIT_SECONDS" ]; do
    ip route | grep -q '^default ' && break
    count=$((count + 1))
    sleep 1
done
firefox_bin=$(command -v firefox || command -v firefox-official)
if [ "$BROWSER_MODE" = kiosk ]; then
    set -- --kiosk
else
    set -- --new-window
fi
# Restart after closing the window; configuration and browsing stay in RAM.
while :; do
    "$firefox_bin" --no-remote --profile "$HOME/.mozilla/firefox/kiosk" "$@" "$START_URL" || true
    sleep 2
done
